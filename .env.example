# PostgreSQL password (used in the database connection string)
POSTGRES_PASSWORD=scanner

# Secret key used to encrypt stored auth credentials — change this in production!
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-32-chars!!

# Public URL of the backend API as seen from the user's browser.
# Change to your server's public hostname/IP when deploying remotely.
NEXT_PUBLIC_API_URL=http://localhost:8000
